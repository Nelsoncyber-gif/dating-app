generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SwipeDirection {
  LIKE
  PASS
}

enum NotificationType {
  MATCH
  MESSAGE
  LIKE
  POST_LIKE
  POST_COMMENT
  GROUP_INVITE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  dob           DateTime
  gender        Gender
  bio           String?
  location      String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  isEmailVerified Boolean @default(false)
  verificationCode String?
  verificationCodeExpiresAt DateTime?

  photos            Photo[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  stories           Story[]
  storyViews        StoryView[]
  sentSwipes        Swipe[]              @relation("SwipesSent")
  receivedSwipes    Swipe[]              @relation("SwipesReceived")
  matchesAsA        Match[]              @relation("MatchUserA")
  matchesAsB        Match[]              @relation("MatchUserB")
  messages          Message[]
  conversations     ConversationParticipant[]
  notifications     Notification[]
  communityMemberships CommunityMember[]
  reportsMade       Report[]             @relation("ReportsMade")
  reportsReceived   Report[]             @relation("ReportsReceived")
  blockedUsers      Block[]              @relation("BlockingUser")
  blockedByUsers    Block[]              @relation("BlockedUser")
  isPremium         Boolean              @default(false)
  premiumUntil      DateTime?

  isVerified         Boolean  @default(false)
  verificationStatus String   @default("unverified")
  verificationExtId  String?  @unique

  callerCalls   CallLog[] @relation("CallerCalls")
  receiverCalls CallLog[] @relation("ReceiverCalls")

  interests      UserInterest[]
  superLikesUsed Int      @default(0)
  boostedUntil   DateTime?
  lastDailyPickAt DateTime?

  isPhotoVerified    Boolean            @default(false)
  emergencyContact   EmergencyContact?
  activeSafetyCheck  SafetyCheck?
  isIncognito        Boolean            @default(false)

  theme         String   @default("light")
  occupation    String?
  education     String?
  zodiacSign    String?
  loveLanguage  String?

  createdEvents     Event[]
  eventAttendees    EventAttendee[]
  sentDateProposals DateProposal[] @relation("DateProposer")
  pushSubscriptions  PushSubscription[]

  profilePrompts    ProfilePrompt[]
  videoIntro        VideoIntro?
  messageReactions  MessageReaction[]
}

model Photo {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  isProfilePic  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Swipe {
  id          String         @id @default(uuid())
  swiperId    String
  swiper      User           @relation("SwipesSent", fields: [swiperId], references: [id], onDelete: Cascade)
  swipedId    String
  swiped      User           @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  direction   SwipeDirection
  isSuperLike Boolean @default(false)
  createdAt   DateTime       @default(now())

  @@unique([swiperId, swipedId])

  @@index([swiperId, createdAt])
  @@index([swipedId, createdAt])
}

model Match {
  id            String   @id @default(uuid())
  userAId       String
  userA         User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  conversationId String?  @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  milestones    Milestone[]

  @@unique([userAId, userBId])

  @@index([userAId])
  @@index([userBId])
}

model Conversation {
  id            String   @id @default(uuid())
  isGroup       Boolean  @default(false)
  name          String?
  createdAt     DateTime @default(now())

  participants  ConversationParticipant[]
  messages      Message[]
  match         Match?
  community     Community?
  dateProposals DateProposal[]
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  mediaUrl        String?
  mediaType       String?
  createdAt       DateTime     @default(now())
  readAt          DateTime?
  reactions       MessageReaction[]
  @@index([conversationId, createdAt])
}

model Post {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String?
  imageUrl    String?
  mediaType   String   @default("image")
  createdAt   DateTime @default(now())

  likes       PostLike[]
  comments    PostComment[]
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Story {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl      String?
  caption       String?
  type          String   @default("media")
  backgroundColor String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime // set to createdAt + 24h when created

  views         StoryView[]
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, userId])
}

model Community {
  id             String        @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  members     CommunityMember[]
  events      Event[]
}

model CommunityMember {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime  @default(now())

  @@unique([communityId, userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Report {
  id            String   @id @default(uuid())
  reporterId    String
  reporter      User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId    String
  reported      User     @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason        String
  createdAt     DateTime @default(now())
}

model Block {
  id           String   @id @default(uuid())
  blockerId    String
  blocker      User     @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId    String
  blocked      User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model CallLog {
  id         String   @id @default(uuid())
  callerId   String
  caller     User     @relation("CallerCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceiverCalls", fields: [receiverId], references: [id], onDelete: Cascade)
  type       String   // "voice" or "video"
  status     String   // "completed", "missed", "rejected"
  duration   Int      @default(0) // in seconds
  createdAt  DateTime @default(now())
}

model Interest {
  id    String         @id @default(uuid())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model EmergencyContact {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  phone  String
  email  String?
}

model SafetyCheck {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInTime  DateTime
  deadline     DateTime
  location     String?
  status       String   @default("active") // active, checked_in, alerted
  shareLocation Boolean @default(false)
  sharedWith   String?
  lastLat      Float?
  lastLng      Float?
}

model Event {
  id           String          @id @default(uuid())
  title        String
  description  String?
  date         DateTime
  location     String
  coverImage   String?
  creatorId    String
  creator      User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  communityId  String?
  community    Community?      @relation(fields: [communityId], references: [id], onDelete: SetNull)
  maxAttendees Int?
  attendees    EventAttendee[]
  createdAt    DateTime        @default(now())
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("going") // "going" or "interested"
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model DateProposal {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposerId       String
  proposer         User         @relation("DateProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  proposedDate     DateTime
  proposedLocation String
  status           String       @default("pending") // "pending", "accepted", "declined"
  createdAt        DateTime     @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())
  @@unique([messageId, userId])
}

model ProfilePrompt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Milestone {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      String
  reachedAt DateTime @default(now())
  @@unique([matchId, type])
}

model VideoIntro {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl  String
  createdAt DateTime @default(now())
}
